{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Disable Command + H",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Disable Fn key and map Command + . to open Emoji Picker",
                        "manipulators": [
                            {
                                "conditions": [],
                                "from": {
                                    "key_code": "fn",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [],
                                "type": "basic"
                            },
                            {
                                "conditions": [],
                                "from": {
                                    "key_code": "period",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "spacebar",
                                        "modifiers": ["control", "command"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change Left Command+F to Right Control+F in Firefox",
                        "enabled": false,
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^org\\.mozilla\\.firefox$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "f",
                                    "modifiers": {
                                        "mandatory": ["left_command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "f",
                                        "modifiers": ["right_command"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Switch Command+Tab to Control+Tab only in Firefox",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^org\\.mozilla\\.firefox$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "tab",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "tab",
                                        "modifiers": ["control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Mac OSX: disable cmd + h to prevent minimising an application window",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "tab",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Delete single word with command + backspace",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "delete_or_backspace",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "delete_or_backspace",
                                        "modifiers": ["option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Delete single word with command + backspace",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "delete_or_backspace",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "delete_or_backspace",
                                        "modifiers": ["option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Close window with option + shift + q",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "q",
                                    "modifiers": { "mandatory": ["option", "shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "w",
                                        "modifiers": ["command"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Launch System Color Picker",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "x",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [{ "shell_command": "open -b com.sindresorhus.System-Color-Picker" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Open new Firefox window with Option + Shift + Enter",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": {
                                        "mandatory": ["option", "shift"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "shell_command": "open -na 'Firefox'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Open Terminal with Option + Enter",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": {
                                        "mandatory": ["option"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "shell_command": "open -na kitty" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Mac OSX: left cmd + shift + q → close application",
                        "enabled": false,
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "command-shift-q",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "q",
                                    "modifiers": { "mandatory": ["left_command", "left_shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "q",
                                        "modifiers": ["left_command"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "q",
                                    "modifiers": { "mandatory": ["left_command", "left_shift"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "command-shift-q",
                                            "value": 1
                                        }
                                    }
                                ],
                                "to_delayed_action": {
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "command-shift-q",
                                                "value": 0
                                            }
                                        }
                                    ],
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "command-shift-q",
                                                "value": 0
                                            }
                                        }
                                    ]
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Use right control key as command key",
                        "enabled": false,
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.microsoft\\.Excel$",
                                            "^com\\.microsoft\\.Powerpoint$",
                                            "^com\\.microsoft\\.Word$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": { "key_code": "right_control" },
                                "to": [{ "key_code": "right_command" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Use left command key as control key in kitty terminal",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^net\\.kovidgoyal\\.kitty$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": { "key_code": "left_command" },
                                "to": [{ "key_code": "left_control" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "apple_vendor_top_case_key_code": "keyboard_fn" },
                    "to": [{ "key_code": "left_command" }]
                },
                {
                    "from": { "key_code": "caps_lock" },
                    "to": [{ "key_code": "escape" }]
                },
                {
                    "from": { "key_code": "escape" },
                    "to": [{ "key_code": "caps_lock" }]
                },
                {
                    "from": { "key_code": "left_command" },
                    "to": [{ "key_code": "left_control" }]
                },
                {
                    "from": { "key_code": "left_control" },
                    "to": [{ "key_code": "left_option" }]
                },
                {
                    "from": { "key_code": "left_option" },
                    "to": [{ "apple_vendor_top_case_key_code": "keyboard_fn" }]
                }
            ],
            "virtual_hid_keyboard": { "keyboard_type_v2": "iso" }
        }
    ]
}